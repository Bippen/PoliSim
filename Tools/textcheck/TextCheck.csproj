<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>textcheck</AssemblyName>
    <RootNamespace>PoliSim.TextCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0649;CS0219</NoWarn>
  </PropertyGroup>
  <!-- §576: the output and intermediate paths moved to Directory.Build.props, which is imported BEFORE Microsoft.Common.props - see the note there. -->
  <ItemGroup>
    <Compile Include="Shims.cs" />
    <Compile Include="CheckExitShim.cs" />
    <Compile Include="Runner.cs" />
    <Compile Include="CommentOnly.cs" />
    <Compile Include="../../Assets/Editor/SourceText.cs" />
    <Compile Include="../../Assets/Editor/RatchetLedger.cs" />
    <Compile Include="../../Assets/Editor/CommentClaimCheck.cs" />
    <Compile Include="../../Assets/Editor/UpstreamCheck.cs" />
    <Compile Include="../../Assets/Editor/DocumentClaimCheck.cs" />
    <Compile Include="../../Assets/Editor/PreWiringPremiseCheck.cs" />
    <Compile Include="../../Assets/Editor/DesignNotificationCheck.cs" />
    <Compile Include="../../Assets/Editor/PlaySheetGenerator.cs" />
    <Compile Include="../../Assets/Editor/PlaySheetCheck.cs" />
    <Compile Include="../../Assets/Editor/MojibakeCheck.cs" />
    <Compile Include="../../Assets/Editor/ResidueCheck.cs" />
  </ItemGroup>
  <!-- RL-1 (ruled 2026-09-23, s588): the review ledger's comment-only test parses both versions with the compiler's own parser. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
