# The gameplay audit's area 1, second plan: the artifacts fixed and re-run, two loads in one campaign, and save -> quit -> resume in a fresh session.
# A resumed run (resume=) loads an earlier run's file (save=, which plays on and loads nothing) through the saves screen's own load route, in its own
# play-mode session - as a player who quits and comes back. Pairs are compared by date where their lines cannot pair (coarser frames, a resume).
#
# --- re-runs: the multi-day frame and the scenario verdict, now that day 0 is the start's own date and pairs compare by date ---
id=b1_se_base country=Sweden party=M style=idle seed=301 days=300
id=b1_se_multiday country=Sweden party=M style=idle seed=301 days=300 delta=0.333 compare=b1_se_base
id=b1_fund_fine country=Sweden scenario=inherit_the_fund party=M style=idle seed=341 days=4500 delta=0.05
id=b1_fund_coarse country=Sweden scenario=inherit_the_fund party=M style=idle seed=341 days=4500 delta=0.333 compare=b1_fund_fine
#
# --- two loads inside one campaign (the CAMPAIGN REPLAY errors of area1's a1_se_s_sl and a1_de_sl came from a second load in a session) ---
id=b2_se_m_base country=Sweden party=M style=idle seed=361 days=300
id=b2_se_m_two country=Sweden party=M style=idle seed=361 days=300 saveload=190,220 compare=b2_se_m_base
id=b2_se_s_base country=Sweden party=S style=idle seed=362 days=300
id=b2_se_s_two country=Sweden party=S style=idle seed=362 days=300 saveload=190,220 compare=b2_se_s_base
id=b2_se_s_three country=Sweden party=S style=idle seed=362 days=300 saveload=190,220,236 compare=b2_se_s_base
id=b2_de_base country=Germany party=SPD style=idle seed=363 days=200
id=b2_de_two country=Germany party=SPD style=idle seed=363 days=200 saveload=60,90 compare=b2_de_base
id=b2_se_fuzz_base country=Sweden party=M style=fuzz seed=364 days=300
id=b2_se_fuzz_two country=Sweden party=M style=fuzz seed=364 days=300 saveload=195,215,230 compare=b2_se_fuzz_base
