# The gameplay audit's area 3: elections - every system, thresholds, seat allocation, presidential rounds, election night (docs/audit/AUDIT_PROTOCOL.md).
# The invariants check each new record's shares (sum 1), seats (the chamber) and date (the statute's rule); each night's Canvas text is kept
# (<id>.night<n>.txt) to be read against the record (inventory C D-01). Leads: inventory C §7 (D-01..D-25).
#
# --- Sweden: two ordinary elections (2026, 2030) from every kind of seat ---
id=f1_se_m country=Sweden party=M style=idle seed=701 days=1760
id=f1_se_s country=Sweden party=S style=idle seed=702 days=1760
id=f1_se_sd country=Sweden party=SD style=historical seed=703 days=1760
id=f1_se_c country=Sweden party=C style=fuzz seed=704 days=1760
id=f1_se_l country=Sweden party=L style=idle seed=705 days=1760
id=f1_se_mp_x country=Sweden party=MP style=extreme pole=small seed=706 days=1760
# --- Sweden: an extra election forced - S moves no confidence early (35 seats take it up, 175 carry it), and after SD withdraws its support ---
id=f2_se_s_motion country=Sweden party=S style=idle seed=711 days=400 motion=10
id=f2_se_sd_withdraw country=Sweden party=SD style=idle seed=712 days=400 withdraw=10 motion=12
id=f2_se_sd_fuzz country=Sweden party=SD style=fuzz seed=713 days=400 withdraw=20 motion=25,60
