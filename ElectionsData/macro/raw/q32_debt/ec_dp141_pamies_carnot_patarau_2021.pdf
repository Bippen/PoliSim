         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Do Fundamentals Explain Differences between Euro Area Sovereign Interest Rates?</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A study of the determinants of sovereign interest rate spreads of euro area countries and in particular the role of fundamentals (fiscal, macroeconomic and institutional variables), using panel regressions.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>European Commission, Economic and Financial Affairs, European Economy, Disucssion Paper</rdf:li>
            </rdf:Bag>
